{
  "name": "slopsidian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Independent .NET/Blazor vault editor with an experimental Obsidian plugin API subset.",
  "scripts": {
    "build:ui": "node tools/build.mjs",
    "build": "npm run typecheck && npm run build:ui && dotnet build src\\RonSijm.Slopsidian\\RonSijm.Slopsidian.csproj --configuration Debug --nologo",
    "build:web": "npm run typecheck && npm run build:ui && node tools\\publish-web.mjs",
    "verify:web": "node tools\\verify-web.mjs",
    "start:web": "node tools\\serve-web.mjs --open",
    "start": "electron .",
    "setup:runtime": "pwsh -NoProfile -File tools\\install-electron.ps1",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test --test-concurrency=1 tests\\vault.test.mjs tests\\core.test.mjs tests\\files.test.mjs tests\\metadata.test.mjs tests\\markdown.test.mjs tests\\search.test.mjs tests\\graph.test.mjs tests\\canvas.test.mjs tests\\browser-vault.test.mjs tests\\core-benchmark.test.mjs tests\\webviewer.test.mjs tests\\web-history.test.mjs tests\\web-reader.test.mjs tests\\web-clip.test.mjs tests\\web-zoom.test.mjs tests\\web-adblock.test.mjs tests\\bases.test.mjs tests\\recovery.test.mjs tests\\audio.test.mjs tests\\mermaid.test.mjs tests\\workspaces.test.mjs tests\\workspace-transition.test.mjs tests\\web-reader-appearance.test.mjs tests\\web-reader-progress.test.mjs tests\\web-history-menu.test.mjs tests\\web-clip-defaults.test.mjs tests\\web-reader-typography.test.mjs tests\\web-reader-selection.test.mjs tests\\web-reader-paragraph-spacing.test.mjs tests\\web-reader-letter-spacing.test.mjs tests\\web-reader-custom-width.test.mjs tests\\web-reader-custom-font.test.mjs tests\\web-reader-progress-history.test.mjs tests\\web-history-filter.test.mjs tests\\web-history-date-range.test.mjs",
    "smoke:web": "node tools\\web-smoke.mjs",
    "smoke": "node tools\\smoke.mjs",
    "benchmark:core": "node tools\\core-benchmark.mjs",
    "smoke:community": "node tools\\smoke.mjs --community",
    "smoke:reported-plugins": "node tools\\smoke.mjs --reported-plugins",
    "smoke:reported-plugins:web": "node tools\\web-smoke.mjs --reported-plugins",
    "smoke:suggestions": "node tools\\smoke.mjs --suggestions",
    "smoke:suggestions:web": "node tools\\web-smoke.mjs --suggestions",
    "smoke:renderers": "node tools\\smoke.mjs --renderers",
    "smoke:renderers:web": "node tools\\web-smoke.mjs --renderers",
    "smoke:templater": "node tools\\smoke.mjs --templater",
    "smoke:templater:web": "node tools\\web-smoke.mjs --templater",
    "smoke:webviewer": "node tools\\webviewer-smoke.mjs",
    "smoke:web-history": "node tools\\webviewer-smoke.mjs --history",
    "smoke:web-reader": "node tools\\webviewer-smoke.mjs --reader",
    "smoke:web-clip": "node tools\\webviewer-smoke.mjs --clip",
    "smoke:web-zoom": "node tools\\webviewer-smoke.mjs --zoom",
    "smoke:web-adblock": "node tools\\webviewer-smoke.mjs --adblock",
    "smoke:bases": "node tools\\smoke.mjs --bases",
    "smoke:bases:web": "node tools\\web-smoke.mjs --bases",
    "smoke:recovery": "node tools\\smoke.mjs --recovery",
    "smoke:recovery:web": "node tools\\web-smoke.mjs --recovery",
    "smoke:audio": "node tools\\smoke.mjs --audio",
    "smoke:audio:web": "node tools\\web-smoke.mjs --audio",
    "smoke:mermaid": "node tools\\smoke.mjs --mermaid",
    "smoke:mermaid:web": "node tools\\web-smoke.mjs --mermaid",
    "smoke:workspaces": "node tools\\smoke.mjs --workspaces",
    "smoke:workspaces:web": "node tools\\web-smoke.mjs --workspaces",
    "smoke:bases-summaries": "node tools\\smoke.mjs --bases-summaries",
    "smoke:bases-summaries:web": "node tools\\web-smoke.mjs --bases-summaries",
    "smoke:workspace-transition": "node tools\\smoke.mjs --workspace-transition",
    "smoke:workspace-transition:web": "node tools\\web-smoke.mjs --workspace-transition",
    "smoke:workspace-transition:webviewer": "node tools\\webviewer-smoke.mjs --adblock --transition",
    "smoke:web-reader-appearance": "node tools\\webviewer-smoke.mjs --reader-appearance",
    "smoke:web-reader-progress": "node tools\\webviewer-smoke.mjs --reader-progress",
    "smoke:web-history-menu": "node tools\\webviewer-smoke.mjs --history-menu",
    "smoke:web-history-copy": "node tools\\webviewer-smoke.mjs --history-copy --transition",
    "smoke:web-clip-lists": "node tools\\webviewer-smoke.mjs --clip-lists --transition",
    "smoke:web-clip-tables": "node tools\\webviewer-smoke.mjs --clip-tables --transition",
    "smoke:web-clip-selection": "node tools\\webviewer-smoke.mjs --clip-selection --transition",
    "smoke:web-clip-properties": "node tools\\webviewer-smoke.mjs --clip-properties --transition",
    "smoke:web-clip-defaults": "node tools\\webviewer-smoke.mjs --clip-defaults --transition",
    "smoke:web-reader-typography": "node tools\\webviewer-smoke.mjs --reader-typography --transition",
    "smoke:web-reader-selection": "node tools\\webviewer-smoke.mjs --reader-selection --transition",
    "smoke:web-reader-paragraph-spacing": "node tools\\webviewer-smoke.mjs --reader-paragraph-spacing --transition",
    "smoke:web-reader-letter-spacing": "node tools\\webviewer-smoke.mjs --reader-letter-spacing --transition",
    "smoke:web-reader-custom-width": "node tools\\webviewer-smoke.mjs --reader-custom-width --transition",
    "smoke:web-reader-custom-font": "node tools\\webviewer-smoke.mjs --reader-custom-font --transition",
    "smoke:web-reader-progress-history": "node tools\\webviewer-smoke.mjs --reader-progress-history --transition",
    "smoke:web-history-filter": "node tools\\webviewer-smoke.mjs --history-filter --transition",
    "smoke:web-history-date-range": "node tools\\webviewer-smoke.mjs --history-date-range --transition"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/collab": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@ghostery/adblocker": "2.20.1",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/lr": "^1.0.0",
    "@mozilla/readability": "0.6.0",
    "@types/codemirror": "5.60.18",
    "@types/node": "26.6.5",
    "codemirror": "5.65.21",
    "codemirror6": "npm:codemirror@6.0.2",
    "dompurify": "3.4.17",
    "electron": "39.8.3",
    "esbuild": "0.28.2",
    "marked": "18.1.1",
    "mermaid": "12.2.0",
    "moment": "2.30.1",
    "obsidian": "1.14.4",
    "typescript": "7.0.2",
    "yaml": "2.8.2"
  }
}
