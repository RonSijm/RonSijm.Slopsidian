<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Slopsidian Native</Product>
    <Version>0.2.0-preview.1</Version>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="LinuxClientVersion" Value="$(Version)" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <ProjectReference Include="../RonSijm.Slopsidian.Core/RonSijm.Slopsidian.Core.csproj" />
    <AvaloniaResource Include="Assets/tux-notebook.png" />
    <AvaloniaResource Include="../RonSijm.Slopsidian/wwwroot/icons.svg" Link="Assets/icons.svg" />
    <Content Include="../RonSijm.Slopsidian/wwwroot/icons-LICENSE.txt" Link="licenses/Slopsidian-Icons.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PrepareNativePublish" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <!-- The reference supplies services, not a second runnable web application. -->
    <RemoveDir Directories="$(PublishDir)wwwroot" />
    <ItemGroup>
      <UnusedWebHost Include="$(PublishDir)RonSijm.Slopsidian;$(PublishDir)RonSijm.Slopsidian.exe;$(PublishDir)RonSijm.Slopsidian.runtimeconfig.json;$(PublishDir)RonSijm.Slopsidian.deps.json;$(PublishDir)*.staticwebassets.*.json" />
    </ItemGroup>
    <Delete Files="@(UnusedWebHost)" />
    <Copy SourceFiles="%(ResolvedRuntimePack.PackageDirectory)/LICENSE.TXT"
          DestinationFiles="$(PublishDir)licenses/%(ResolvedRuntimePack.NuGetPackageId)/LICENSE.txt"
          Condition="Exists('%(ResolvedRuntimePack.PackageDirectory)/LICENSE.TXT')" />
    <Copy SourceFiles="%(ResolvedRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES.TXT"
          DestinationFiles="$(PublishDir)licenses/%(ResolvedRuntimePack.NuGetPackageId)/THIRD-PARTY-NOTICES.txt"
          Condition="Exists('%(ResolvedRuntimePack.PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" />
  </Target>
</Project>
